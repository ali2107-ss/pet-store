# Пример переменных окружения для локальной разработки
# Скопируйте в `.env.local` и заполните своими значениями

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_key...

# НЕ добавляйте `SUPABASE_SERVICE_ROLE_KEY` в клиентские файлы/репозиторий.
# Service Role Key должен храниться только на сервере и в секрете.
